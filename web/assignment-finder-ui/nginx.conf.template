server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # API_INTERNAL_HOST defaults to the docker-compose service name; in Azure Container Apps,
        # set it to the api app's internal FQDN within the same Container Apps Environment.
        proxy_pass http://${API_INTERNAL_HOST}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Angular client-side routing: fall back to index.html for unknown paths.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
