{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=db;Database=AssignmentFinder;User Id=sa;Password=#{SA_PASSWORD}#;TrustServerCertificate=True;"
  },
  "Scan": {
    "CronSchedule": "0 0 */3 * * ?"
  },
  "Email": {
    "Host": "#{SMTP_HOST}#",
    "Port": 587,
    "FromAddress": "#{SMTP_FROM}#",
    "Username": "#{SMTP_USERNAME}#",
    "Password": "#{SMTP_PASSWORD}#",
    "UseSsl": true
  }
}
