# Copy this file to .env and fill in real values before running docker-compose up.

SA_PASSWORD=ChangeMe_Strong_Password123!
JWT_SIGNING_KEY=change-me-to-a-long-random-string-at-least-32-chars

# The one bootstrap admin account - seeded automatically (and re-approved/re-promoted to Admin
# on every startup) regardless of what happens to it via the normal register/approve flow.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=ChangeMe_Admin_Password123!

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=assignment-finder@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true

# Quartz cron expression for how often brokers are scanned (default: every 3 hours).
SCAN_CRON_SCHEDULE=0 0 */3 * * ?
